# ---- Application ----
APP_ENV=development
APP_NAME="API Traffic Management Platform"
LOG_LEVEL=INFO
LOG_JSON=false                      # true => JSON logs (prod), false => console-friendly (dev)
DEBUG=true

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Database ----
# async driver is required (asyncpg)
DATABASE_URL=postgresql+asyncpg://apitraffic:apitraffic@localhost:5432/apitraffic

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Security / Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900        # 15 min
REFRESH_TOKEN_TTL_SECONDS=1209600   # 14 days
REFRESH_COOKIE_SECURE=false         # true in production (HTTPS only)

# ---- Gateway ----
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=15
GATEWAY_MAX_BODY_BYTES=1048576      # 1 MiB request body cap forwarded upstream

# ---- Auth rate limiting (brute-force protection) ----
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- CORS (comma-separated origins for the dashboard) ----
CORS_ORIGINS=http://localhost:5173

# ---- Telemetry ----
TELEMETRY_ENABLED=true
