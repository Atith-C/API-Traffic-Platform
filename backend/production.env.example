# Production environment template. Copy to .env and fill with real secrets from your secret manager.
# NEVER commit the filled-in version.

APP_ENV=production
APP_NAME="API Traffic Management Platform"
LOG_LEVEL=INFO
LOG_JSON=true
DEBUG=false

HOST=0.0.0.0
PORT=8000

# Point at managed Postgres (asyncpg driver required).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db-host:5432/apitraffic

REDIS_URL=redis://redis-host:6379/0

# MUST be a long, random, secret value from your secret manager.
JWT_SECRET=__SET_ME__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_COOKIE_SECURE=true

GATEWAY_UPSTREAM_TIMEOUT_SECONDS=15
GATEWAY_MAX_BODY_BYTES=1048576

AUTH_RATE_LIMIT_PER_MINUTE=10

# Lock this down to your real dashboard origin(s).
CORS_ORIGINS=https://dashboard.example.com

TELEMETRY_ENABLED=true
